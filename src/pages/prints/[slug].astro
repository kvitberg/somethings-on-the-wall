---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import EditionLine from '../../components/EditionLine.astro';
import { eur, href, pad, prints, printsInRoom, SITE_URL, type Print } from '../../lib/prints';

export function getStaticPaths() {
  return prints.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Print };
const i = prints.indexOf(p);
const prev = prints[(i - 1 + prints.length) % prints.length];
const next = prints[(i + 1) % prints.length];
const roommates = printsInRoom(p.room.id).filter((x) => x.slug !== p.slug).slice(0, 3);
const chosen = p.sizes.find((z) => z.id === p.defaultSize) ?? p.sizes[0];
---

<Base title={p.title} image={`${SITE_URL}/og/${p.slug}.jpg`} description={`${p.title}${p.place ? `, ${p.place}` : ''}. A signed print by Scott Kvitberg in an edition of ${p.editionSize}.`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href('/programme/')}>The programme</a>
      <span class="num">Exhibit {p.numberLabel} / {prints.length} · {p.room.title}</span>
    </nav>
  </div>

  <article>
    <section class="wrap top" aria-labelledby="print-title">
      <div class="intro">
        <h1 id="print-title">{p.title}</h1>
        {p.place && <p class="place">{p.place}</p>}
        <p class="caption">{p.caption}</p>

        <fieldset class="sizes" data-sizes>
          <legend class="visually-hidden">Choose a size</legend>
          {
            p.sizes.map((z) => (
              <label class="size">
                <input type="radio" name="size" value={z.id} checked={z.id === chosen.id} data-url={z.url} data-price={eur(z.priceEur)} disabled={p.soldOut} />
                <span class="size-name num">{z.label}</span>
                <span class="size-cm num">{z.cm}</span>
                <span class="size-price num">{eur(z.priceEur)}</span>
              </label>
            ))
          }
        </fieldset>

        <div class="buy">
          <p class="price num" data-price-out>{eur(chosen.priceEur)}</p>
          {
            p.hasCheckout ? (
              <a class="collect" href={chosen.url} rel="noopener" data-collect>
                Collect No. {pad(p.nextNumber)} <Arrow />
              </a>
            ) : p.soldOut ? (
              <span class="collect" aria-disabled="true">Edition sold out</span>
            ) : (
              <span class="collect" aria-disabled="true" data-preview>
                Collect No. {pad(p.nextNumber)} <Arrow />
              </span>
            )
          }
        </div>
        <p class="launch-note">
          {p.hasCheckout || p.soldOut ? '' : 'Checkout opens at launch. '}Shipping {eur(p.shippingEur)}, added at checkout.
        </p>

        <EditionLine size={p.editionSize} sold={p.sold} />

        <p class="note">Printed to order and shipped with a certificate carrying your edition number and the photographer's signature.</p>
      </div>

      <div class="photo-col">
        <div class="photo">
          <Image
            src={p.image}
            alt={p.caption}
            widths={[700, 1100, 1500, 2000]}
            sizes="(min-width: 980px) 55vw, 100vw"
            loading="eager"
            fetchpriority="high"
            style={`view-transition-name: vt-${p.slug}`}
          />
        </div>
      </div>
    </section>

    <section class="wrap specs" aria-label="Print details">
      <dl>
        <div><dt>Sizes</dt><dd class="num">{p.sizes.map((z) => z.label).join(', ')}</dd></div>
        <div><dt>Paper</dt><dd>{p.paper}</dd></div>
        <div><dt>Finish</dt><dd>{p.frame}</dd></div>
        <div><dt>Edition</dt><dd>{p.editionSize} prints across all sizes, signed and numbered</dd></div>
      </dl>
    </section>

    {
      roommates.length > 0 && (
        <section class="wrap more" aria-labelledby="more-title">
          <header class="more-head">
            <h2 id="more-title" class="more-title">Also in {p.room.title}</h2>
            <a class="arrow-link" href={href('/programme/')}>
              Full programme <Arrow />
            </a>
          </header>
          <ul class="more-grid">
            {roommates.map((r) => (
              <li>
                <a href={href(`/prints/${r.slug}/`)}>
                  <div class="more-photo">
                    <Image src={r.image} alt={r.caption} widths={[400, 700]} sizes="(min-width: 900px) 30vw, 90vw" loading="lazy" />
                  </div>
                  <span class="more-name">{r.title}</span>
                  <span class="more-place">{r.place ?? p.room.line}</span>
                  <span class="more-left num">{r.remaining} of {r.editionSize} available</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="wrap pager" aria-label="More prints">
      <a href={href(`/prints/${prev.slug}/`)}><span class="pager-label">Previous</span><span class="pager-name">{prev.title}</span></a>
      <a href={href(`/prints/${next.slug}/`)} class="to-next"><span class="pager-label">Next</span><span class="pager-name">{next.title}</span></a>
    </nav>
  </article>
</Base>

<style>
  .crumbs {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 4px var(--space-4);
    font-size: 12px;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .crumbs a {
    color: var(--ink);
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 4.4fr) minmax(0, 7.6fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  .intro {
    display: grid;
    gap: var(--space-3);
    max-width: 30rem;
  }
  h1 {
    font-size: clamp(52px, 6.4vw, 96px);
    line-height: 0.94;
    letter-spacing: -0.01em;
    color: var(--cobalt);
  }
  .place {
    font-size: 13px;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: calc(var(--space-1) * -1);
  }
  .caption {
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 34ch;
  }
  .sizes {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--hairline);
  }
  .size {
    display: grid;
    grid-template-columns: 20px 1fr auto auto;
    gap: 14px;
    align-items: center;
    padding: 12px 4px;
    border-bottom: 1px solid var(--hairline);
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out);
  }
  .size:hover {
    background: var(--stone-deep);
  }
  .size input {
    accent-color: var(--cobalt);
    width: 16px;
    height: 16px;
    margin: 0;
  }
  .size-name {
    font-variation-settings: 'wght' 560;
  }
  .size-cm {
    color: var(--ink-soft);
    font-size: 14px;
  }
  .size-price {
    min-width: 4.5rem;
    text-align: right;
  }
  .size:has(input:checked) {
    color: var(--cobalt);
  }
  .size:has(input:checked) .size-cm {
    color: inherit;
  }
  .buy {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-1);
  }
  .price {
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: 'wght' 320;
  }
  .launch-note {
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: calc(var(--space-2) * -1);
  }
  .note {
    font-size: 14px;
    color: var(--ink-soft);
    max-width: 40ch;
  }

  .specs {
    margin-top: var(--space-6);
  }
  .specs dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
  }
  .specs div {
    padding: var(--space-3) var(--space-3) 0 0;
  }
  .specs div + div {
    padding-left: var(--space-3);
    border-left: 1px solid var(--hairline);
  }
  .specs dt {
    font-size: 12px;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  .specs dd {
    margin: 0;
    font-size: 17px;
  }

  .photo-col {
    margin-right: calc(-1 * (max(0px, (100vw - var(--max)) / 2) + var(--gutter)));
  }
  .photo {
    --ph: max(520px, min(calc(100svh - 210px), 880px));
    display: grid;
    place-items: center;
    height: var(--ph);
    padding: 48px;
    background: var(--stone-deep);
  }
  .photo img {
    max-height: calc(var(--ph) - 96px);
    max-width: 100%;
    width: auto;
    box-shadow: 0 2px 4px rgb(22 22 26 / 0.08), 0 28px 50px -26px rgb(22 22 26 / 0.5);
  }
  .more-title {
    font-size: clamp(36px, 4vw, 56px);
  }
  .more {
    margin-top: var(--space-7);
  }
  .more-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .more-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 40px);
  }
  .more-grid a {
    display: grid;
    gap: 6px;
    text-decoration: none;
  }
  .more-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--stone-deep);
    margin-bottom: 14px;
  }
  .more-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .more-grid a:hover img {
    transform: scale(1.035);
  }
  .more-name {
    font-size: 13px;
    font-variation-settings: 'wght' 680;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .more-place {
    font-size: 15px;
    color: var(--ink-soft);
  }
  .more-left {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vermilion-ink);
    font-variation-settings: 'wght' 560;
  }

  .pager {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .pager a {
    display: grid;
    gap: 6px;
    padding-top: var(--space-3);
    border-top: 1px solid var(--hairline);
    text-decoration: none;
  }
  .pager .to-next {
    text-align: right;
  }
  .pager-label {
    font-size: 12px;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .pager-name {
    font-size: clamp(26px, 3vw, 40px);
    letter-spacing: -0.035em;
    font-variation-settings: 'wght' 340;
  }

  @media (max-width: 980px) {
    .top {
      grid-template-columns: 1fr;
    }
    .photo-col {
      order: -1;
      margin-inline: calc(-1 * var(--gutter));
    }
    .photo {
      --ph: auto;
      height: auto;
      padding: 24px;
    }
    .photo img {
      max-height: calc(78svh - 48px);
    }
    .intro {
      max-width: none;
    }
    .specs dl {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-3);
    }
    .specs div + div:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .more-grid {
      grid-template-columns: 1fr 1fr;
    }
    .more-grid li:nth-child(3) {
      display: none;
    }
  }
</style>

<script>
  // Choosing a size updates the price and which Stripe link the Collect button opens.
  const group = document.querySelector<HTMLElement>('[data-sizes]');
  const priceOut = document.querySelector('[data-price-out]');
  const collect = document.querySelector<HTMLAnchorElement>('[data-collect]');
  group?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (priceOut) priceOut.textContent = input.dataset.price ?? '';
    if (collect && input.dataset.url) collect.href = input.dataset.url;
  });
</script>
