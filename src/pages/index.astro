---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { detailOf, eur, featured, href, pad, prints } from '../lib/prints';

const pick = (s: string) => prints.find((p) => p.slug === s)!;
// The four prints the hero cycles through; the featured print leads.
// The four photographs the hero cycles through, strongest first. focus keeps the subject in frame when cropped.
const slides = [pick('aurora-lofoten'), featured, pick('santana'), pick('oslo-s')];
const focus: Record<string, string> = { 'aurora-lofoten': '50% 28%', 'the-red-wall': '62% 58%', santana: '50% 42%', 'oslo-s': '50% 62%' };
const programme = prints.slice(0, 5);
const band = pick('the-long-gallery');
---

<Base title="Somethings on the wall">
  <section class="wrap hero" data-slider aria-label="Now showing">
    <h1 class="hero-title caps">
      <span class="line"><span>Somethings</span></span>
      <span class="line"><span>on the</span></span>
      <span class="line"><span>wall</span></span>
    </h1>

    <div class="hero-counter num">
      <button type="button" data-step="-1" aria-label="Previous print"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
      <span><span data-counter>01</span> &mdash; {pad(slides.length)}</span>
      <button type="button" data-step="1" aria-label="Next print"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
      <span class="visually-hidden" aria-live="polite" data-announce></span>
    </div>

    <div class="hero-info" data-reveal style="--i:3">
      <div class="intro">
        <p>A season of photographs by Scott Kvitberg, printed for real walls. Twenty-seven pictures, and twenty-five signed prints of each.</p>
        <a class="arrow-link" href={href('/about/')}>About the prints <Arrow /></a>
      </div>
      <p class="meta">
        Oslo, Norway<br /><span class="meta-dash" aria-hidden="true"></span><br />Season<br />2026
      </p>
    </div>

    <div class="hero-scene">
      {
        slides.map((p, i) => (
          <a class:list={['slide', { active: i === 0 }]} data-slide={i} href={href(`/prints/${p.slug}/`)} tabindex={i === 0 ? undefined : -1}>
            <Image
              src={p.image}
              alt={p.caption}
              widths={[700, 1100, 1600, 2000]}
              sizes="(min-width: 900px) 52vw, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              style={`object-position:${focus[p.slug] ?? '50% 50%'};${i === 0 ? `view-transition-name: vt-${p.slug}` : ''}`}
            />
            <span class="slide-caption">
              <span class="num">No. {p.numberLabel}</span> {p.title}
            </span>
          </a>
        ))
      }
    </div>

    <div class="hero-blocks">
      <div class="detail" data-reveal="img" style="--i:4">
        {
          slides.map((p, i) => {
            const d = detailOf(p);
            return (
              <div class:list={['detail-slide', { active: i === 0 }]} data-slide={i}>
                <Image src={p.image} alt="" widths={[500, 800]} sizes="(min-width: 900px) 18vw, 50vw" loading={i === 0 ? 'eager' : 'lazy'} style={`--zx:${d.x}%;--zy:${d.y}%;--zoom:${d.zoom}`} />
              </div>
            );
          })
        }
      </div>
      <div class="box on-cobalt" data-reveal style="--i:5">
        <svg class="ring" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.5" /></svg>
        <h2 class="box-title caps">Now<br />showing</h2>
        {
          slides.map((p, i) => (
            <div class:list={['box-slide', { active: i === 0 }]} data-slide={i}>
              <p class="box-name">{p.title}</p>
              <p class="box-meta num">
                Exhibit {p.numberLabel} · {eur(p.priceEur)} · {p.remaining} of {p.editionSize} left
              </p>
              <a class="arrow-link" href={href(`/prints/${p.slug}/`)} tabindex={i === 0 ? undefined : -1}>
                Collect <Arrow />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap programme" aria-labelledby="programme-title">
    <header class="programme-head">
      <h2 id="programme-title" class="caps programme-title" data-reveal>Programme</h2>
      <p class="programme-line" data-reveal style="--i:1">Every photograph in the season, what it shows and which room it belongs to.</p>
      <a class="arrow-link" href={href('/programme/')} data-reveal style="--i:2">See the full programme <Arrow /></a>
    </header>
    <div class="table" role="table" aria-label="The programme, first five prints" data-reveal style="--i:2">
      <div class="tr th" role="row">
        <span role="columnheader">No.</span><span role="columnheader">Title</span><span role="columnheader" class="c-desc">Description</span><span role="columnheader">Room</span>
      </div>
      {
        programme.map((p) => (
          <a class="tr" role="row" href={href(`/prints/${p.slug}/`)}>
            <span role="cell" class="num">{p.numberLabel}</span>
            <span role="cell" class="t-title">{p.title}</span>
            <span role="cell" class="c-desc" title={p.caption}>{p.caption}</span>
            <span role="cell">{p.room.title}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="band" aria-labelledby="band-title">
    <div class="band-photo" data-reveal="img">
      <Image src={band.image} alt={band.caption} widths={[800, 1300, 1800]} sizes="(min-width: 900px) 56vw, 100vw" loading="lazy" />
    </div>
    <div class="band-panel">
      <h2 id="band-title" class="caps band-title" data-reveal>On the<br />wall</h2>
      <p data-reveal style="--i:1">Photographs printed once, in one format, twenty-five times, and signed. Never reprinted, never discounted.</p>
      <a class="arrow-link" href={href('/about/#editions')} data-reveal style="--i:2">How editions work <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  /* Hero: title, counter, intro and blocks on the left; the sunlit wall on the right */
  .hero {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'title counter'
      'title scene'
      'info scene'
      'blocks scene';
    grid-template-rows: auto auto 1fr auto;
    column-gap: 8px;
    padding-top: var(--space-4);
  }
  .hero-title {
    grid-area: title;
    font-size: min(7cqi, 124px);
    color: var(--cobalt);
    padding-right: var(--space-3);
  }
  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .hero-title .line > span {
    display: block;
  }
  .hero-counter {
    grid-area: counter;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    margin-bottom: var(--space-3);
  }
  .hero-counter button {
    appearance: none;
    background: none;
    border: 0;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: inherit;
    border-radius: 50%;
    transition: background-color 0.25s var(--ease-out);
  }
  .hero-counter button:hover {
    background: var(--stone-deep);
  }
  .hero-counter svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .hero-info {
    grid-area: info;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4) var(--space-3) var(--space-4) 0;
  }
  .intro {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .intro p {
    font-size: 18px;
    line-height: 1.5;
    max-width: 30ch;
  }
  .meta {
    font-size: 12px;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.7;
  }
  .meta-dash {
    display: inline-block;
    width: 18px;
    height: 1px;
    background: currentColor;
    vertical-align: middle;
  }

  /* The photograph, large, to the right edge */
  .hero-scene {
    grid-area: scene;
    position: relative;
    min-height: max(560px, calc(100svh - 230px));
    margin-right: calc(-1 * (max(0px, (100vw - var(--max)) / 2) + var(--gutter)));
    overflow: hidden;
    background: var(--night);
  }
  .slide {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 0.9s var(--ease-out);
  }
  .slide.active {
    opacity: 1;
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 6s var(--ease-out);
  }
  .slide.active img {
    transform: none;
  }
  .slide-caption {
    position: absolute;
    left: 24px;
    bottom: 20px;
    color: #fff;
    font-size: 12px;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.45);
  }
  .slide-caption .num {
    opacity: 0.75;
    margin-right: 8px;
  }

  /* Detail and blue note under the intro */
  .hero-blocks {
    grid-area: blocks;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 8px;
    margin-left: calc(-0.5 * var(--gutter));
  }
  .detail {
    position: relative;
    overflow: hidden;
    min-height: 230px;
  }
  .detail-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
  }
  .detail-slide.active {
    opacity: 1;
  }
  .detail-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: var(--zx) var(--zy);
    scale: var(--zoom);
  }
  .box {
    position: relative;
    background: var(--cobalt);
    color: var(--on-cobalt);
    padding: 26px 26px 24px;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-3);
    min-height: 230px;
  }
  .ring {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }
  .box-title {
    font-size: 30px;
    color: var(--on-cobalt);
  }
  .box-slide {
    grid-row: 2;
    grid-column: 1;
    display: grid;
    gap: 6px;
    align-content: end;
    justify-items: start;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-out), visibility 0s linear 0.6s;
  }
  .box-slide.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--ease-out) 0.15s, visibility 0s;
  }
  .box-name {
    font-family: var(--display);
    font-size: 26px;
    line-height: 1.1;
  }
  .box-meta {
    font-size: 14px;
    color: var(--on-cobalt-soft);
    margin-bottom: 10px;
  }

  /* Programme preview */
  .programme {
    margin-top: var(--space-6);
  }
  .programme-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: end;
    margin-bottom: var(--space-4);
  }
  .programme-title {
    font-size: min(6.4vw, 100px);
    color: var(--cobalt);
    white-space: nowrap;
  }
  .programme-line {
    max-width: 30ch;
    padding-bottom: 8px;
  }
  .programme-head .arrow-link {
    padding-bottom: 10px;
  }
  .table {
    border-bottom: 1px solid var(--rule);
  }
  .tr {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1.2fr) minmax(0, 1.7fr) minmax(0, 0.45fr);
    gap: var(--space-3);
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    font-size: 15px;
    transition: background-color 0.25s var(--ease-out), padding 0.4s var(--ease-out);
  }
  a.tr:hover {
    background: var(--stone-deep);
    padding-inline: 12px;
  }
  .th {
    border-top: 0;
    padding-bottom: 14px;
    font-size: 12px;
    font-variation-settings: 'wght' 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .t-title {
    font-family: var(--display);
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.1;
  }
  .c-desc {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .th .c-desc {
    white-space: normal;
  }

  /* Closing band */
  .band {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    margin: var(--space-6) clamp(8px, 1.2vw, 16px) 0;
    min-height: 480px;
  }
  .band-photo {
    overflow: hidden;
    position: relative;
  }
  .band-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }
  .band-panel {
    background: var(--vermilion);
    color: #fff;
    padding: clamp(32px, 5vw, 72px);
    display: grid;
    align-content: center;
    gap: var(--space-3);
    justify-items: start;
  }
  .band-title {
    font-size: min(7vw, 104px);
    color: #fff;
  }
  .band-panel p {
    font-size: 18px;
    max-width: 30ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-title .line > span {
      transform: translateY(105%);
      animation: rise 1.1s var(--ease-out) forwards;
    }
    :global(html.js) .hero-title .line:nth-child(2) > span {
      animation-delay: 0.1s;
    }
    :global(html.js) .hero-title .line:nth-child(3) > span {
      animation-delay: 0.2s;
    }
  }
  @keyframes rise {
    to {
      transform: none;
    }
  }

  @media (max-width: 1180px) {
    .programme-head {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .programme-head .arrow-link {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas: 'title' 'scene' 'counter' 'info' 'blocks';
      padding-top: var(--space-2);
    }
    .hero-title {
      font-size: min(14cqi, 96px);
    }
    .hero-info {
      padding-right: 0;
    }
    .hero-title {
      margin-bottom: var(--space-3);
    }
    .hero-counter {
      margin: 10px 0 0;
    }
    .hero-info {
      padding-top: var(--space-3);
    }
    .hero-scene {
      min-height: min(118vw, 560px);
      margin-inline: calc(-1 * var(--gutter));
    }
    .hero-blocks {
      margin: 8px 0 0;
    }
    .programme-head {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .programme-title {
      font-size: min(12.5vw, 96px);
    }
    .tr {
      grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    }
    .c-desc {
      display: none;
    }
    .band {
      grid-template-columns: 1fr;
    }
    .band-photo {
      aspect-ratio: 4 / 3;
    }
    .band-title {
      font-size: min(16vw, 88px);
    }
  }
  @media (max-width: 560px) {
    .hero-info {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .hero-blocks {
      grid-template-columns: 1fr;
    }
    .detail {
      min-height: 200px;
    }
  }
</style>

<script>
  // The counter steps through the four photographs; the large photo, detail and note change together.
  for (const root of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    const groups = ['.slide', '.detail-slide', '.box-slide'].map((s) => [...root.querySelectorAll<HTMLElement>(s)]);
    const total = groups[0].length;
    const counter = root.querySelector('[data-counter]');
    const announce = root.querySelector('[data-announce]');
    let current = 0;
    const show = (next: number) => {
      current = (next + total) % total;
      for (const els of groups) {
        els.forEach((el, i) => {
          el.classList.toggle('active', i === current);
          el.querySelectorAll('a').forEach((a) => (i === current ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
          if (el.tagName === 'A') i === current ? el.removeAttribute('tabindex') : el.setAttribute('tabindex', '-1');
        });
      }
      if (counter) counter.textContent = String(current + 1).padStart(2, '0');
      const name = root.querySelectorAll('.box-name')[current]?.textContent ?? '';
      if (announce) announce.textContent = `${name}, ${current + 1} of ${total}`;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.step))));
  }
</script>
